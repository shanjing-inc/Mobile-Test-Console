{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "test-analysis.run.v1"
    },
    "project": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": true
    },
    "target": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "app",
            "mini-program"
          ]
        },
        "runtime": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "appId": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "platform"
      ],
      "additionalProperties": true
    },
    "run": {
      "type": "object",
      "properties": {
        "runId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "status": {
          "type": "string",
          "enum": [
            "queued",
            "running",
            "passed",
            "failed",
            "cancelled",
            "interrupted",
            "unknown"
          ]
        },
        "environment": {
          "type": "string",
          "default": ""
        },
        "startedAt": {
          "type": "string",
          "default": ""
        },
        "finishedAt": {
          "type": "string",
          "default": ""
        }
      },
      "required": [
        "runId",
        "status"
      ],
      "additionalProperties": true
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "caseRunId": {
            "type": "string",
            "minLength": 1
          },
          "caseId": {
            "type": "string",
            "default": ""
          },
          "title": {
            "type": "string",
            "default": ""
          },
          "status": {
            "type": "string",
            "default": "unknown"
          },
          "targetPage": {
            "type": "string",
            "default": ""
          },
          "scenario": {
            "type": "string",
            "default": ""
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "stepId": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "default": ""
                },
                "status": {
                  "type": "string",
                  "default": "unknown"
                },
                "startedAt": {
                  "type": "string",
                  "default": ""
                },
                "finishedAt": {
                  "type": "string",
                  "default": ""
                },
                "durationMs": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null
                },
                "evidenceRefs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "default": []
                }
              },
              "required": [
                "stepId"
              ],
              "additionalProperties": true
            },
            "default": []
          },
          "assertions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "assertionId": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "type": "string",
                  "minLength": 1
                },
                "passed": {
                  "type": "boolean"
                },
                "description": {
                  "type": "string",
                  "default": ""
                },
                "evidenceRefs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "default": []
                }
              },
              "required": [
                "assertionId",
                "kind",
                "passed"
              ],
              "additionalProperties": true
            },
            "default": []
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "logs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "apiCalls": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": {}
            },
            "default": []
          },
          "errorSummary": {
            "type": "string",
            "default": ""
          }
        },
        "required": [
          "caseRunId"
        ],
        "additionalProperties": true
      },
      "default": []
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "uri": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "default": ""
          },
          "role": {
            "type": "string",
            "enum": [
              "screenshot",
              "recording",
              "log",
              "trace",
              "network",
              "evidence",
              "other"
            ],
            "default": "other"
          },
          "mimeType": {
            "type": "string",
            "default": "application/octet-stream"
          },
          "sizeBytes": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "id",
          "uri"
        ],
        "additionalProperties": true
      },
      "default": []
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "provenance": {
      "type": "object",
      "properties": {
        "adapter": {
          "type": "string",
          "default": ""
        },
        "adapterVersion": {
          "type": "string",
          "default": ""
        },
        "sourceRevision": {
          "type": "string",
          "default": ""
        },
        "generatedAt": {
          "type": "string",
          "default": ""
        }
      },
      "additionalProperties": true,
      "default": {}
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {},
      "default": {}
    }
  },
  "required": [
    "schemaVersion",
    "project",
    "target",
    "run"
  ],
  "additionalProperties": true,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mobile-test-console.dev/schemas/test-analysis.run.v1.schema.json",
  "title": "Mobile Test Console Result Bundle v1"
}
