{
  "name": "mobile-test-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "mobile-test-console": "dist/server/cli.js"
  },
  "engines": {
    "node": ">=18.20.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch src/server/cli.ts",
    "dev:web": "vite",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "pnpm typecheck && vite build && tsup src/server/cli.ts --format esm --platform node --target node18 --out-dir dist/server --sourcemap --clean",
    "start": "node dist/server/cli.js",
    "check": "pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@fastify/static": "^7.0.4",
    "fastify": "^4.29.1",
    "lucide-react": "^0.468.0",
    "open": "^10.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^20.17.12",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "tsx": "^4.19.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "packageManager": "pnpm@10.28.2"
}
